# Homebrew reads this file on every brew call, whatever shell starts it.
# /opt/homebrew links to nanobrew's prefix, so Homebrew and nanobrew share one Cellar.
# Nanobrew's kegs have no Homebrew install receipt, so autoremove takes them for unused
# dependencies: one brew uninstall removed most of them.
HOMEBREW_NO_AUTOREMOVE=1
