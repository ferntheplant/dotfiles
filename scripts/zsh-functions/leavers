# Rewrite .Nanobrewfile from this machine: leaf formulas and casks from nanobrew, and the
# existing mas lines (nanobrew does not install App Store apps; the mas CLI does)
leave-brew() {
    {
        echo "# Nanobrew"
        nb leaves | awk '{print "brew \"" $1 "\""}'
        nb bundle dump | grep '^cask '
        grep '^mas ' .Nanobrewfile
    } > .Nanobrewfile.tmp && mv .Nanobrewfile.tmp .Nanobrewfile
}

leave-machine() {
    echo "🚀 Leaving machine - capturing all package lists..."
    
    # Ensure we're in dotfiles directory
    cd "$HOME/dotfiles" || {
        echo "❌ Error: Not in dotfiles directory"
        return 1
    }
    
    # Capture all package lists
    leave-brew
    echo "🔍 Nanobrewfile captured"

    # Git operations if -c flag is passed
    if [[ "$*" == *"-c"* ]]; then
        echo "📝 Committing changes..."
        git add .
        git commit -m "Leaving machine - $(date '+%Y-%m-%d %H:%M:%S')"
        git push origin main
    fi
    
    echo "✅ Successfully left machine!"
}
