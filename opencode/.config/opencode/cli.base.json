{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "rosepine",
    "mode": "dark"
  },
  "session": {
    "thinking": "show",
    "verbosity": "low",
    "image_preview": true,
    "permissions": "autoaccept"
  },
  "tabs": {
    "layout": "horizontal"
  },
  "diffs": {
    "view": "auto",
    "wrap": "word",
    "single": false
  },
  "prompt": {
    "paste": "full"
  }
}
