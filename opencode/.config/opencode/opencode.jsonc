{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "openTelemetry": true
  },
  // OpenCode Quota: tuiCommandDisplay chooses whether native TUI command output appears in the session transcript or a local popup dialog.
  // OpenCode Quota: loads the server plugin for slash commands and quota checks.
  "plugin": [
    "@langfuse/opencode-observability-plugin@latest",
    "@slkiser/opencode-quota@latest"
  ],
  "permission": {
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow",
      "/private/tmp/**": "allow",
      "/var/folders/**/T/**": "allow",
      "/private/var/folders/**/T/**": "allow"
    }
  },
  "provider": {
    // Detected openai authentication; opencode-quota added this global provider declaration.
    "openai": {},
    // Detected opencode-go authentication; opencode-quota added this global provider declaration.
    "opencode-go": {}
  },
  "references": {
    "effect": {
      "repository": "Effect-TS/effect",
      "description": "Use when writing or debugging Effect code"
    },
    "vite-plus": {
      "repository": "voidzero-dev/vite-plus",
      "description": "Use when debugging vite-plus configuration and execution"
    },
    "opencode": {
      "repository": "anomalyco/opencode",
      "description": "Use when implementing customizations to the local opencode installation"
    }
  }
}
