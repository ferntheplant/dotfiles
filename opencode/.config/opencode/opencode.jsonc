{
  "$schema": "https://opencode.ai/config.json",
  // OpenCode Quota: loads the server plugin for slash commands and quota checks.
  "plugins": [
    "@slkiser/opencode-quota@latest"
  ],
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/tmp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/var/folders/**/T/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/var/folders/**/T/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/repos/**", "effect": "allow" }
  ],
  "providers": {
    // Detected opencode-go authentication; opencode-quota added this global provider declaration.
    "opencode-go": {}
  },
  "references": {
    "effect": {
      "repository": "Effect-TS/effect",
      "description": "Use when writing or debugging Effect code"
    },
    "vite-plus": {
      "repository": "voidzero-dev/vite-plus",
      "description": "Use when debugging vite-plus configuration and execution"
    },
    "opencode": {
      "repository": "anomalyco/opencode",
      "description": "Use when implementing customizations to the local opencode installation"
    }
  }
}
