font-family = MesloLGS NF Regular
font-feature = -calt
font-feature = -liga
font-feature = -dlig

theme = dark:Rose Pine Moon,light:Rose Pine Dawn

window-theme = system
window-save-state = always

cursor-style = block
cursor-style-blink = true

shell-integration-features = no-cursor

resize-overlay-position = bottom-right

macos-titlebar-style = hidden
macos-titlebar-proxy-icon = hidden
macos-option-as-alt = true

custom-shader = shaders/cursor_smear.glsl

unfocused-split-opacity = 0.7
unfocused-split-fill = #030303
split-divider-color = #3C9629

keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right
