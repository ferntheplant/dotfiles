{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,
  "app": {
    "appearance": "system",
    "focusPaneOnFirstClick": true,
    "minimalMode": true,
    "warnBeforeQuit": true,
    "sendAnonymousTelemetry": false,
    "renameSelectsExistingName": true,
    "preferredEditor": "hx",
    "reorderOnNotification": false,
    "newWorkspacePlacement": "afterCurrent",
    "commandPaletteSearchesAllSurfaces": false
  },
  "sidebar": {
    "branchLayout": "vertical",
    "openPortLinksInCmuxBrowser": true,
    "openPullRequestLinksInCmuxBrowser": false,
    "showBranchDirectory": false,
    "showCustomMetadata": true,
    "showLog": true,
    "showNotificationMessage": true,
    "showPorts": false,
    "showProgress": true,
    "showPullRequests": false,
    "showSSH": true
  },
  "sidebarAppearance": {
    "matchTerminalBackground": true
  },
  "automation": {
    "claudeCodeIntegration": false,
    "socketControlMode": "allowAll"
  },
  "commands": [
    {
      "name": "tycho-worktree",
      "description": "Tycho worktree dev environment: agent, shell, client, and server",
      "keywords": ["tycho", "worktree", "dev", "client", "server"],
      "workspace": {
        "name": "Tycho Worktree",
        "cwd": ".",
        "layout": {
          "direction": "vertical",
          "split": 0.5,
          "children": [
            {
              "pane": {
                "surfaces": [
                  {
                    "type": "terminal",
                    "name": "agent",
                    "focus": true
                  }
                ]
              }
            },
            {
              "direction": "horizontal",
              "split": 0.5,
              "children": [
                {
                  "pane": {
                    "surfaces": [
                      {
                        "type": "terminal",
                        "name": "shell"
                      }
                    ]
                  }
                },
                {
                  "direction": "vertical",
                  "split": 0.5,
                  "children": [
                    {
                      "pane": {
                        "surfaces": [
                          {
                            "type": "terminal",
                            "name": "client",
                            "command": "pnpm run client"
                          }
                        ]
                      }
                    },
                    {
                      "pane": {
                        "surfaces": [
                          {
                            "type": "terminal",
                            "name": "server",
                            "command": "pnpm run server"
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ]
}
