// Skills copied from other repos and edited in place. Each entry records the upstream commit the
// local copy was last merged from (`base`), so `/rebaseline skills` can tell a local edit from an
// upstream change and three-way merge one into the other. A skill in `.agents/skills/` with no
// entry here is this repo's own.
//
// Every local edit gets a comment on its entry saying what changed and why: the next merge reads
// those comments to decide which side of a conflict to keep. An edit with no comment reads as
// drift, and the merge is free to take upstream's version over it.
//
// Every skill here comes from baseline, which vendors most of them from other repos and merges
// their upstream changes first. Run `/rebaseline skills` in baseline, then here. Here, the skills
// are global: `scripts/link-skills.sh` links each one into `~/.claude/skills/`, where Claude Code
// and Pi both find it. The local edits make a skill work outside a repo made from baseline.
{
  "sources": {
    "baseline": {
      "repo": "https://github.com/ferntheplant/baseline",
      "ref": "main",
      // Baseline has no license of its own. Its vendored skills keep their upstream licenses:
      // mattpocock-skills.txt (codebase-design, grilling, pr, prototype, research, wizard,
      // writing-for-agents), explain-diff-html.txt (explain-diff), agent-browser.txt (agent-browser).
      // rebaseline is baseline's own.
      "license": ".agents/licenses/",
    },
  },
  // Keyed by the skill's directory under `.agents/skills/`.
  "skills": {
    "agent-browser": {
      "source": "baseline",
      "path": ".agents/skills/agent-browser",
      "base": "a38d11491844455a7cfb37baf5e54b1539bde123",
      // Local: runs the repo's `mise.toml` install inside a repo that has one, and the global
      // install (`.Nanobrewfile`) elsewhere, since the skill is global here.
    },
    "codebase-design": {
      "source": "baseline",
      "path": ".agents/skills/codebase-design",
      "base": "a38d11491844455a7cfb37baf5e54b1539bde123",
    },
    "explain-diff": {
      "source": "baseline",
      "path": ".agents/skills/explain-diff",
      "base": "2a7f642a6b274b7c321ae584bd6a2879160e5f9c",
    },
    "grilling": {
      "source": "baseline",
      "path": ".agents/skills/grilling",
      "base": "a38d11491844455a7cfb37baf5e54b1539bde123",
    },
    "pr": {
      "source": "baseline",
      "path": ".agents/skills/pr",
      "base": "a2e7ed101b37531ae57a1da47fca706e3166b008",
    },
    "prototype": {
      "source": "baseline",
      "path": ".agents/skills/prototype",
      "base": "a2e7ed101b37531ae57a1da47fca706e3166b008",
      // Local: a UI prototype runs with the project's own runner, `vp run <name>` only in a Vite+
      // repo, since the skill is global here.
    },
    "rebaseline": {
      "source": "baseline",
      "path": ".agents/skills/rebaseline",
      "base": "a2e7ed101b37531ae57a1da47fca706e3166b008",
      // Local: adds the `files` branch for `.agents/vendored-files.jsonc` (the agent instructions,
      // which do not come from baseline), merged with `git merge-file` since a file's local name
      // differs from upstream's. Also reads `.scratch/vendored-skills.jsonc` and its `skillsDir`
      // key, so the same skill rebaselines the Pillar repo's skills in `.scratch/skills/`, and runs
      // that repo's own checks in place of `vp run ready:agent`.
    },
    "research": {
      "source": "baseline",
      "path": ".agents/skills/research",
      "base": "a38d11491844455a7cfb37baf5e54b1539bde123",
    },
    "wizard": {
      "source": "baseline",
      "path": ".agents/skills/wizard",
      "base": "1a2c64296ec056acd71ae6b929ef1b3a827d1f49",
    },
    "writing-for-agents": {
      "source": "baseline",
      "path": ".agents/skills/writing-for-agents",
      "base": "a2e7ed101b37531ae57a1da47fca706e3166b008",
    },
  },
}
