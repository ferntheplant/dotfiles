(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold   yes
  macos-dev-names-exclude (
    "Karabiner DriverKit VirtualHIDKeyboard 1.8.0"
    "Corne-ish Zen"
    "Agar Mini BLE (USB)"
  )
)

(defvar
  tap-time 160
  hold-time 220
)


(defalias
  fn (layer-while-held fn)

  ;; This example is similar to the default caps-word behaviour but it moves the
  ;; 0-9 keys to the capitalized key list from the extra non-terminating key list.
  capw (caps-word 2000)


  ;; left hand home-row mods
  a (tap-hold $tap-time $hold-time a lctl)
  s (tap-hold $tap-time $hold-time s lmet)
  d (tap-hold $tap-time $hold-time d lalt)
  f (tap-hold $tap-time $hold-time f lsft)
  ;; right hand home-row mods
  j (tap-hold $tap-time $hold-time j rsft)
  k (tap-hold 210 220 k ralt)
  l (tap-hold $tap-time $hold-time l rmet)
  ; (tap-hold $tap-time $hold-time ; rctl)

  esctl (tap-hold $tap-time $hold-time esc lctl)

  meh  (multi ctl alt sft)
)

(defchordsv2
  (k m) @meh 100 first-release ()
  (d c) @meh 100 first-release ()
)

(defsrc
  esc    f1    f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12
  grv    1     2     3     4     5     6     7     8     9     0     -     =     bspc
  tab    q     w     e     r     t     y     u     i     o     p     [     ]     \
  caps   a     s     d     f     g     h     j     k     l     ;     '     ret
  lsft   z     x     c     v     b     n     m     ,     .     /     rsft
  fn     lctl  lalt  lmet              spc               rmet  ralt  ◀    ▲ ▼    ▶
)

(deflayer base
  _      🔅     🔆     mctl  sls   dtn   dnd   ◀◀    ▶⏸    ▶▶    🔇     🔉     🔊
  _      _     _     _     _     _     _     _     _     _     _     _     _     _
  _      _     _     _     _     _     _     _     _     _     _     _     _     _
  @esctl @a    @s    @d    @f    _     _     @j    @k    @l    @;    _     _
  _      _     _     _     _     _     _     _     _     _     _     _
  @fn    _     @meh  _                 _                 _     @meh  _    _ _    _
)

(deflayer fn
  _      f1    f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12
  _      _     _     _     _     _     _     _     _     _     _     _     _     del
  _      _     _     _     lrld  _     _     _     _     _     _     _     _     _
  _      _     _     _     _     _     _     _     _     _     _     _     _
  _      _     _     _     _     _     _     _     _     _     _     _
  _      _     _     _                 _                 _     _     ⤒    ⇞ ⇟    ⤓
)
