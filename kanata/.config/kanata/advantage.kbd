(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold   yes
  macos-dev-names-exclude (
    "Karabiner DriverKit VirtualHIDKeyboard 1.8.0"
    "Apple Internal Keyboard / Trackpad"
    "Fernando’s Magic Keyboard"
    "AVA"
    "Corne-ish Zen"
    "Agar Mini BLE (USB)"
  )
)

(defvar
  tap-time 160
  hold-time 220
)

(defalias
  ;; left hand home-row mods
  a (tap-hold $tap-time $hold-time a lctl)
  s (tap-hold $tap-time $hold-time s lmet)
  d (tap-hold $tap-time $hold-time d lalt)
  f (tap-hold $tap-time $hold-time f lsft)
  ;; right hand home-row mods
  j (tap-hold $tap-time $hold-time j rsft)
  k (tap-hold 210 220 k ralt)
  l (tap-hold $tap-time $hold-time l rmet)
  ; (tap-hold $tap-time $hold-time ; rctl)

  meh  (multi ctl alt sft)
)

(defchordsv2
  (k m) @meh 100 first-release ()
  (d v) @meh 100 first-release ()
)

(defsrc
  =      1     2     3     4     5     6     7     8     9     0     -
  tab    q     w     e     r     t     y     u     i     o     p     \
  caps   a     s     d     f     g     h     j     k     l     ;     '
  lsft   z     x     c     v     b     n     m     ,     .     /     rsft
         grv       ◀     ▶                 ▲     ▼     [     ]
                     lctl  lalt              rmet  rctl
         bspc  del   home  end               pgdn  pgup  ret   spc
)

(deflayer base
  _      _     _     _     _     _     _     _     _     _     _     _
  _      _     _     _     _     _     _     _     _     _     _     _
  esc    @a    @s    @d    @f    _     _     @j    @k    @l    @;    _
  _      _     _     _     _     _     _     _     _     _     _     _
         _        _     _                 _     _     _     _
                      _     _                 _     _
         bspc  esc   XX    XX                XX    XX   _     spc
)
