	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#b7b7b0"
	line-numbers-right-style = "#b7b7b0"
	line-numbers-zero-style = "#b7b7b0"
	line-numbers-minus-style = bold "#ab5959"
	line-numbers-plus-style = bold "#1e754f"
	minus-emph-style = bold syntax "#dfcac5"
	minus-style = syntax "#e8ded7"
	plus-emph-style = bold syntax "#c9d7cb"
	plus-style = syntax "#dbe3d9"
	map-styles = \
