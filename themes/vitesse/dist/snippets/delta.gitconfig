# Vitesse delta features. Generated by themes/build.mjs — do not edit by hand.
# [include] this file, then set [delta] features = <one of the names below>.
# Requires the matching bat themes (syntax-theme), installed and cached with `bat cache --build`.

[delta "vitesse-dark"]
	dark = true
	syntax-theme = vitesse-dark
	blame-palette = "#121212 #181818 #181818 #272727"
	commit-decoration-style = box ul
	file-style = "#cecabe"
	file-decoration-style = "#cecabe"
	hunk-header-decoration-style = box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#858480"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#52514f"
	line-numbers-right-style = "#52514f"
	line-numbers-zero-style = "#52514f"
	line-numbers-minus-style = bold "#cb7676"
	line-numbers-plus-style = bold "#4d9375"
	minus-emph-style = bold syntax "#422828"
	minus-style = syntax "#2e2121"
	plus-emph-style = bold syntax "#253a31"
	plus-style = syntax "#1b2521"
	map-styles = \
		bold purple => syntax "#442a35", \
		bold blue => syntax "#26333d", \
		bold cyan => syntax "#25383b", \
		bold yellow => syntax "#47412b"

[delta "vitesse-dark-soft"]
	dark = true
	syntax-theme = vitesse-dark-soft
	blame-palette = "#222222 #292929 #292929 #353535"
	commit-decoration-style = box ul
	file-style = "#cfcbbf"
	file-decoration-style = "#cfcbbf"
	hunk-header-decoration-style = box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#8c8b87"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#5d5c5a"
	line-numbers-right-style = "#5d5c5a"
	line-numbers-zero-style = "#5d5c5a"
	line-numbers-minus-style = bold "#cb7676"
	line-numbers-plus-style = bold "#4d9375"
	minus-emph-style = bold syntax "#4d3333"
	minus-style = syntax "#3b2f2f"
	plus-emph-style = bold syntax "#2f453c"
	plus-style = syntax "#28332e"
	map-styles = \
		bold purple => syntax "#503641", \
		bold blue => syntax "#323f49", \
		bold cyan => syntax "#314447", \
		bold yellow => syntax "#534d37"

[delta "vitesse-light"]
	light = true
	syntax-theme = vitesse-light
	blame-palette = "#ffffff #f7f7f7 #f7f7f7 #eaeaea"
	commit-decoration-style = box ul
	file-style = "#393a34"
	file-decoration-style = "#393a34"
	hunk-header-decoration-style = box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#8f908c"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#c1c1bf"
	line-numbers-right-style = "#c1c1bf"
	line-numbers-zero-style = "#c1c1bf"
	line-numbers-minus-style = bold "#ab5959"
	line-numbers-plus-style = bold "#1e754f"
	minus-emph-style = bold syntax "#ead5d5"
	minus-style = syntax "#f5ebeb"
	plus-emph-style = bold syntax "#d4e3dd"
	plus-style = syntax "#e8f1ed"
	map-styles = \
		bold purple => syntax "#e7cdd8", \
		bold blue => syntax "#c9dae8", \
		bold cyan => syntax "#c9e4e8", \
		bold yellow => syntax "#eee8cd"

[delta "vitesse-light-soft"]
	light = true
	syntax-theme = vitesse-light-soft
	blame-palette = "#f1f0e9 #e7e5db #e7e5db #deddd6"
	commit-decoration-style = box ul
