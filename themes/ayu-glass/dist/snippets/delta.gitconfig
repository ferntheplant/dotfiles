# Ayu Glass delta features. Generated by themes/build.mjs — do not edit by hand.
# [include] this file, then set [delta] features = <one of the names below>.
# Requires the matching bat themes (syntax-theme), installed and cached with `bat cache --build`.

[delta "ayu-glass-dark"]
	dark = true
	syntax-theme = ayu-glass-dark
	blame-palette = "#0d1016 #16181e #1f2227 #1f3a4d"
	commit-decoration-style = box ul
	file-style = "#bfbdb6"
	file-decoration-style = "#bfbdb6"
	hunk-header-decoration-style = box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#8a8986"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#4b4c4e"
	line-numbers-right-style = "#4b4c4e"
	line-numbers-zero-style = "#4b4c4e"
	line-numbers-minus-style = bold "#ef7177"
	line-numbers-plus-style = bold "#aad84c"
	minus-emph-style = bold syntax "#2a1318"
	minus-style = syntax "#2f1e24"
	plus-emph-style = bold syntax "#1b2815"
	plus-style = syntax "#242e1e"
	map-styles = \
		bold purple => syntax "#3e3650", \
		bold blue => syntax "#203c50", \
		bold cyan => syntax "#2f4543", \
		bold yellow => syntax "#493926"

[delta "ayu-glass-mirage"]
	dark = true
	syntax-theme = ayu-glass-mirage
	blame-palette = "#242835 #2c303c #353944 #375065"
	commit-decoration-style = box ul
	file-style = "#cccac2"
	file-decoration-style = "#cccac2"
	hunk-header-decoration-style = box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#9a9a98"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#575c6b"
	line-numbers-right-style = "#575c6b"
	line-numbers-zero-style = "#575c6b"
	line-numbers-minus-style = bold "#f18779"
	line-numbers-plus-style = bold "#d5fe80"
	minus-emph-style = bold syntax "#362128"
	minus-style = syntax "#43363f"
	plus-emph-style = bold syntax "#334426"
	plus-style = syntax "#3e4840"
	map-styles = \
		bold purple => syntax "#534e68", \
		bold blue => syntax "#385267", \
		bold cyan => syntax "#40575b", \
		bold yellow => syntax "#5b5244"

[delta "ayu-glass-light"]
	light = true
	syntax-theme = ayu-glass-light
	blame-palette = "#fcfcfc #f0f0f1 #eceded #cee6f6"
	commit-decoration-style = box ul
	file-style = "#5c6166"
	file-decoration-style = "#5c6166"
	hunk-header-decoration-style = box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#8b8e92"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#b0b3b5"
	line-numbers-right-style = "#b0b3b5"
	line-numbers-zero-style = "#b0b3b5"
	line-numbers-minus-style = bold "#ef7271"
	line-numbers-plus-style = bold "#85b304"
	minus-emph-style = bold syntax "#fee9e8"
	minus-style = syntax "#faebeb"
	plus-emph-style = bold syntax "#eef2dd"
	plus-style = syntax "#f0f5e3"
	map-styles = \
		bold purple => syntax "#e6dbf0", \
		bold blue => syntax "#cce4f6", \
		bold cyan => syntax "#d0ede3", \
		bold yellow => syntax "#f9e8cf"
