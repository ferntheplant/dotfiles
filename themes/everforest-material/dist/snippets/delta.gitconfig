# Everforest Material delta features. Generated by themes/build.mjs — do not edit by hand.
# [include] this file, then set [delta] features = <one of the names below>.
# Requires the matching bat themes (syntax-theme), installed and cached with `bat cache --build`.

[delta "everforest-material-dark-hard"]
	dark = true
	syntax-theme = everforest-material-dark-hard
	blame-palette = "#272e33 #374145 #2e383c #4c3743"
	commit-decoration-style = box ul
	file-style = "#d3c6aa"
	file-decoration-style = "#d3c6aa"
	hunk-header-decoration-style = box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#859289"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#7a8478"
	line-numbers-right-style = "#7a8478"
	line-numbers-zero-style = "#7a8478"
	line-numbers-minus-style = bold "#e67e80"
	line-numbers-plus-style = bold "#a7c080"
	minus-emph-style = bold syntax "#493b40"
	minus-style = syntax "#433a3e"
	plus-emph-style = bold syntax "#3c4841"
	plus-style = syntax "#3a443e"
	map-styles = \
		bold purple => syntax "#534954", \
		bold blue => syntax "#3d5153", \
		bold cyan => syntax "#3e534b", \
		bold yellow => syntax "#545246"

